SEC_IDENTITY=Financial Research Agent analyst@example.com
DATABASE_PATH=.data/finagent.sqlite3
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODE=responses
LLM_MAX_OUTPUT_TOKENS=4000
LLM_REPORT_OUTPUT_TOKENS=8000
LLM_MAX_RETRIES=2
AGENTIC_RESEARCH=true
AGENT_MAX_TOOL_CALLS=60
AGENT_TIMEOUT_SECONDS=600
WEB_MAX_BYTES=2097152
# Optional custom TOML prompt file; default: src/finagent/prompts.toml
# PROMPT_CONFIG_PATH=/absolute/path/to/prompts.toml
# Default workspace root: next to DATABASE_PATH, in workspaces/
# WORKSPACE_ROOT=/absolute/path/to/workspaces
WORKSPACE_MAX_FILE_BYTES=10485760
WORKSPACE_MAX_TOTAL_BYTES=104857600
WORKSPACE_MAX_FILES=200
WORKSPACE_MAX_TEXT_BYTES=262144

